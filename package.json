{
  "name": "safora",
  "version": "1.0.0",
  "private": true,
  "description": "Safora — encrypted database backups (MongoDB, PostgreSQL) to S3-compatible storage, orchestrated by Node.js and scheduled with GitHub Actions.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc",
    "backup": "tsc && node dist/main.js",
    "backup:local": "pnpm run build && node --env-file-if-exists=.env dist/main.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "age-encryption": "^0.3.1",
    "minimatch": "^11.0.3",
    "mongodb": "^7.8.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  }
}
