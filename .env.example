# ---------------------------------------------------------------------------
# Copy to .env for local runs. In GitHub Actions these values come from
# repository secrets (MONGODB_URI, R2_ACCOUNT_ID, R2_ACCESS_KEY_ID,
# R2_SECRET_ACCESS_KEY, AGE_RECIPIENT) and repository variables
# (R2_BUCKET, RETENTION_DAYS). .env is gitignored — never commit real values.
# ---------------------------------------------------------------------------

# Atlas SRV connection string for the dedicated backup user,
# e.g. mongodb+srv://backup-user:<password>@cluster0.xxxxx.mongodb.net/
MONGODB_URI=

# Cloudflare dashboard → R2 → Account ID (right-hand sidebar)
R2_ACCOUNT_ID=

# R2 → Manage R2 API Tokens → bucket-scoped token (Object Read & Write)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket name (repository variable R2_BUCKET in Actions)
R2_BUCKET=mongodb-backups

# Days to keep backups in R2 (repository variable RETENTION_DAYS in Actions)
RETENTION_DAYS=30

# Log level: trace | debug | info | warn | error | fatal (repository variable
# LOG_LEVEL in Actions). Logs are structured JSON via pino.
LOG_LEVEL=info

# age PUBLIC key — the "age1..." line from `age-keygen -o key.txt`.
# Only the public key belongs here; the AGE-SECRET-KEY-1... line stays offline.
AGE_RECIPIENT=
