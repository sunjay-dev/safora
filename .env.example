# ---------------------------------------------------------------------------
# Copy to .env for local runs. In GitHub Actions these values come from
# repository secrets (MONGODB_URI, POSTGRESQL_URI, S3_ENDPOINT,
# S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, AGE_RECIPIENT) and repository
# variables (S3_BUCKET, DESTINATIONS, RETENTION_DAYS). .env is gitignored —
# never commit real values.
# ---------------------------------------------------------------------------

# Database engine to back up for this run: mongodb (default) or postgres.
# In GitHub Actions, the workflow runs parallel jobs for mongodb and postgres.
# Unset or blank falls back to mongodb; unknown values are rejected.
ENGINE=mongodb

# Atlas SRV connection string for the dedicated backup user (required iff ENGINE=mongodb),
# e.g. mongodb+srv://backup-user:<password>@cluster0.xxxxx.mongodb.net/
MONGODB_URI=

# Optional comma-separated list of database name glob patterns to exclude from MongoDB backup.
# Supports wildcard * (e.g. "scratch_*,*_test,local,config").
# When set, enumerates databases on the cluster and dumps each allowed database individually.
# When unset or blank, dumps the full cluster with point-in-time oplog to a single archive.
# (You can also set DB_BLOCKLIST to share patterns across both MongoDB and PostgreSQL).
MONGODB_DB_BLOCKLIST=scratch_*,*_test

# PostgreSQL connection URI for the dedicated backup user (required iff ENGINE=postgres),
# pointing to the maintenance database (postgres), e.g.
# postgresql://backup:<password>@<host>:5432/postgres?sslmode=require
# The URI is respected verbatim. libpq's default sslmode=prefer can fall back to
# an unencrypted connection on a public endpoint; sslmode=require (or verify-full
# when certificates are configured) is recommended.
POSTGRESQL_URI=

# Optional comma-separated list of database name glob patterns to exclude from backup.
# Supports wildcard * (e.g. "prisma_migrate_shadow_db_*,*_test,template*").
# Unset or blank backs up all non-template databases discovered on the server.
PG_DB_BLOCKLIST=prisma_migrate_shadow_db_*,*_test

# S3-compatible storage configuration (Cloudflare R2, AWS S3, MinIO, etc.)
# S3 bucket name (required when s3 destination is active)
S3_BUCKET=mongodb-backups

# S3 endpoint URL (optional; required for R2/MinIO, omit for native AWS regional endpoints)
S3_ENDPOINT=

# S3 region (optional; defaults to "auto" for R2 endpoints, resolves via AWS SDK for native AWS)
S3_REGION=

# S3 credentials (optional; required for static credentials, omit for ambient IAM / OIDC credentials)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# S3 force path-style (optional boolean; defaults to false, set true for MinIO/LocalStack)
S3_FORCE_PATH_STYLE=false

# Comma-separated destinations for a run: s3, local (unset or blank = s3).
# Selecting local requires LOCAL_BACKUP_DIR.
DESTINATIONS=s3

# Local destination folder, required when DESTINATIONS includes local. The archive
# mirrors the R2 object key under this folder. Relative paths resolve against the
# working directory. The local archive disappears when the workflow finishes, so
# selecting local in CI is generally meaningless.
LOCAL_BACKUP_DIR=

# Days to keep backups in each destination (repository variable RETENTION_DAYS in Actions)
RETENTION_DAYS=30

# Log level (repository variable LOG_LEVEL in Actions). Logs are structured
# JSON via pino. Unset or blank falls back to info; invalid values are rejected.
LOG_LEVEL=info

# --- Pipeline tunables (optional; same names as GitHub repository variables).
# Values shown are the defaults — unset or blank falls back to these. ---

# S3 key prefix for backup objects ("/" appended automatically if missing)
BACKUP_PREFIX=backups/

# mongodump / pg_dump timeout — keep below the workflow job's timeout-minutes (30)
DUMP_TIMEOUT_MS=1200000

# Preflight tool check (mongodump or psql/pg_dump/pg_restore) timeout
TOOL_CHECK_TIMEOUT_MS=30000

# Max child-process output captured, in bytes
MAX_BUFFER=10485760

# age PUBLIC key — the "age1..." line from `age-keygen -o key.txt`.
# Only the public key belongs here; the AGE-SECRET-KEY-1... line stays offline.
AGE_RECIPIENT=
